<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">

    <Appenders>
        <Console name="console">
            <PatternLayout pattern="%d{dd.MM.yyyy HH:mm:ss} *%-5p* %c{1}: %m (%F, line %L)%n"/>
        </Console>

        <!-- ERROR.log -->
        <File name="ERROR" fileName="logs/teams-apis.log">
            <PatternLayout pattern="%d{dd.MM.yyyy HH:mm:ss} *%-5p* %c{1}: %m (%F, line %L)%n"/>
        </File>
    </Appenders>

    <Loggers>
        <!-- Teams APIs Error Handling Classes - Set to DEBUG to see all our logging -->
        <Logger name="app.krista.extensions.essentials.collaboration.teams.catalog.validators" level="DEBUG"/>
        <Logger name="app.krista.extensions.essentials.collaboration.teams.catalog.errorhandlers" level="DEBUG"/>
